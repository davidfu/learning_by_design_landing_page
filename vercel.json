{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/revenue-os",
      "destination": "/gtm",
      "permanent": true
    },
    {
      "source": "/revenue-os.html",
      "destination": "/gtm",
      "permanent": true
    }
  ]
}
